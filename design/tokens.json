{
  "$description": "Daybloom design tokens, v2 (2026-10-12). Started from the Stitch export (Tailwind config in design/stitch/*/code.html + DESIGN.md typography/shadows); accessibility fixes from docs/DESIGN_REVIEW.md section 4 are applied (see changes). design/daybloom/_shared/theme.js mirrors these values. Sizes are dp for React Native.",
  "color": {
    "background": "#fff8f5",
    "onBackground": "#1e1b18",
    "surface": "#fff8f5",
    "surfaceDim": "#e1d8d4",
    "surfaceBright": "#fff8f5",
    "surfaceContainerLowest": "#ffffff",
    "surfaceContainerLow": "#fbf2ed",
    "surfaceContainer": "#f5ece7",
    "surfaceContainerHigh": "#efe6e2",
    "surfaceContainerHighest": "#e9e1dc",
    "surfaceVariant": "#e9e1dc",
    "surfaceTint": "#446650",
    "onSurface": "#1e1b18",
    "onSurfaceVariant": "#424843",
    "inverseSurface": "#34302c",
    "inverseOnSurface": "#f8efea",
    "outline": "#676d67",
    "outlineVariant": "#c1c8c1",
    "primary": "#43654f",
    "onPrimary": "#ffffff",
    "primaryContainer": "#5b7e67",
    "onPrimaryContainer": "#ffffff",
    "inversePrimary": "#aacfb5",
    "primaryFixed": "#c5ecd0",
    "primaryFixedDim": "#aacfb5",
    "onPrimaryFixed": "#002111",
    "onPrimaryFixedVariant": "#2c4e39",
    "secondary": "#8f4b3b",
    "onSecondary": "#ffffff",
    "secondaryContainer": "#fda590",
    "onSecondaryContainer": "#783929",
    "secondaryFixed": "#ffdad2",
    "secondaryFixedDim": "#ffb4a3",
    "onSecondaryFixed": "#3a0a02",
    "onSecondaryFixedVariant": "#723425",
    "tertiary": "#815404",
    "onTertiary": "#ffffff",
    "tertiaryContainer": "#9e6c20",
    "onTertiaryContainer": "#ffffff",
    "tertiaryFixed": "#ffddb5",
    "tertiaryFixedDim": "#f9bb68",
    "onTertiaryFixed": "#2a1800",
    "onTertiaryFixedVariant": "#643f00",
    "error": "#ba1a1a",
    "onError": "#ffffff",
    "errorContainer": "#ffdad6",
    "onErrorContainer": "#93000a",
    "scrim": "#2d2926"
  },
  "categoryColor": {
    "$description": "Proposed default event/task categories. The screens use these color pairs but never define a category list. Lavender comes from DESIGN.md prose and is not used in any screen. All text pairs checked at >= 4.5:1.",
    "wellness": {
      "label": "Wellness",
      "container": "#c5ecd0",
      "onContainer": "#002111",
      "accent": "#43654f"
    },
    "work": {
      "label": "Work",
      "container": "#ffdad2",
      "onContainer": "#3a0a02",
      "accent": "#8f4b3b"
    },
    "personal": {
      "label": "Personal",
      "container": "#ffddb5",
      "onContainer": "#2a1800",
      "accent": "#815404"
    },
    "social": {
      "label": "Social",
      "container": "#ece6f3",
      "onContainer": "#584a6b",
      "accent": "#9b8ea9"
    },
    "creative": {
      "label": "Creative",
      "container": "#e9e1dc",
      "onContainer": "#1e1b18",
      "accent": "#424843"
    }
  },
  "font": {
    "serif": "Literata",
    "sans": "Plus Jakarta Sans",
    "icons": "Material Symbols Outlined",
    "$license": "Literata, Plus Jakarta Sans: SIL Open Font License. Material Symbols: Apache 2.0."
  },
  "typography": {
    "displayLg": {
      "font": "serif",
      "size": 36,
      "lineHeight": 44,
      "weight": "600",
      "letterSpacing": -0.72
    },
    "displayLgMobile": {
      "font": "serif",
      "size": 28,
      "lineHeight": 36,
      "weight": "600",
      "letterSpacing": -0.28
    },
    "headlineLg": {
      "font": "serif",
      "size": 24,
      "lineHeight": 32,
      "weight": "600",
      "letterSpacing": -0.24
    },
    "headlineMd": {
      "font": "serif",
      "size": 20,
      "lineHeight": 28,
      "weight": "500"
    },
    "headlineSm": {
      "font": "serif",
      "size": 18,
      "lineHeight": 26,
      "weight": "500"
    },
    "bodyLg": {
      "font": "sans",
      "size": 16,
      "lineHeight": 24,
      "weight": "400"
    },
    "bodyMd": {
      "font": "sans",
      "size": 14,
      "lineHeight": 20,
      "weight": "400"
    },
    "bodySm": {
      "font": "sans",
      "size": 12,
      "lineHeight": 18,
      "weight": "400"
    },
    "labelLg": {
      "font": "sans",
      "size": 14,
      "lineHeight": 20,
      "weight": "600",
      "letterSpacing": 0.14
    },
    "labelMd": {
      "font": "sans",
      "size": 12,
      "lineHeight": 16,
      "weight": "600",
      "letterSpacing": 0.24
    },
    "labelSm": {
      "font": "sans",
      "size": 12,
      "lineHeight": 16,
      "weight": "700",
      "letterSpacing": 0.48
    },
    "labelXs": {
      "font": "sans",
      "size": 11,
      "lineHeight": 14,
      "weight": "600",
      "letterSpacing": 0.11,
      "$use": "Month grid cell labels only"
    }
  },
  "radius": {
    "$description": "Values the screens actually use (Tailwind config in code.html + Tailwind defaults). DESIGN.md prose says cards are 16; screens use 12 (xl) and 16 (2xl).",
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 12,
    "2xl": 16,
    "full": 9999
  },
  "spacing": {
    "spaceXs": 4,
    "spaceSm": 8,
    "spaceMd": 16,
    "spaceLg": 24,
    "spaceXl": 32,
    "gutterSm": 12,
    "gutter": 16,
    "marginSm": 16,
    "margin": 20,
    "marginLg": 32
  },
  "shadow": {
    "$description": "Warm umber shadow from DESIGN.md: 0 4px 16px -2px rgba(45,41,38,0.06), 0 2px 6px -1px rgba(45,41,38,0.03). React Native supports one shadow per view; use 'card' as the approximation.",
    "card": {
      "color": "#2d2926",
      "opacity": 0.06,
      "radius": 16,
      "offsetY": 4,
      "elevation": 2
    },
    "float": {
      "color": "#2d2926",
      "opacity": 0.12,
      "radius": 24,
      "offsetY": 8,
      "elevation": 6
    }
  },
  "layout": {
    "headerHeight": 64,
    "tabBarHeight": 64,
    "iconSizeNav": 20,
    "avatarSize": 32,
    "minTouchTarget": 48,
    "minTouchTargetDenseGrid": 32
  },
  "opacity": {
    "doneText": 0.75
  },
  "control": {
    "uncheckedBorderColor": "outline",
    "uncheckedBorderWidth": 1.5,
    "$why": "Empty checkboxes and habit circles need a 3:1 boundary (WCAG 1.4.11)"
  },
  "changes": [
    "color.outline #727972 -> #676d67 (4.47:1 -> 4.53:1 on surfaceContainer)",
    "typography.labelSm 10px -> 12px (tab labels, chips, hour labels)",
    "typography.labelXs added at 11px for month cells (were 8-9px)",
    "opacity.doneText 0.75 (was 0.5-0.7; keeps >= 4.5:1)",
    "hour notes use onSurfaceVariant (outlineVariant was 1.66:1)",
    "control.unchecked* added: empty checkboxes/circles were 1.1-1.7:1 against white"
  ]
}
