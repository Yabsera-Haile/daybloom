{
  "expo": {
    "name": "Daybloom",
    "slug": "daybloom",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daybloom",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fff8f5",
    "ios": {
      "bundleIdentifier": "com.daybloom.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.daybloom.app",
      "adaptiveIcon": {
        "backgroundColor": "#5B7E67",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff8f5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/literata/400Regular/Literata_400Regular.ttf",
            "node_modules/@expo-google-fonts/literata/400Regular_Italic/Literata_400Regular_Italic.ttf",
            "node_modules/@expo-google-fonts/literata/500Medium/Literata_500Medium.ttf",
            "node_modules/@expo-google-fonts/literata/600SemiBold/Literata_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/literata/700Bold/Literata_700Bold.ttf",
            "node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
            "node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular_Italic/PlusJakartaSans_400Regular_Italic.ttf",
            "node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
            "node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf"
          ]
        }
      ],
      "expo-localization",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#43654f",
                "dark": "#43654f"
              },
              "colorControlActivated": {
                "light": "#43654f",
                "dark": "#43654f"
              },
              "colorControlHighlight": {
                "light": "#c5ecd0",
                "dark": "#c5ecd0"
              },
              "textColorPrimary": {
                "light": "#1e1b18",
                "dark": "#1e1b18"
              },
              "textColorSecondary": {
                "light": "#424843",
                "dark": "#424843"
              },
              "textColorPrimaryInverse": {
                "light": "#ffffff",
                "dark": "#ffffff"
              },
              "textColorSecondaryInverse": {
                "light": "#c5ecd0",
                "dark": "#c5ecd0"
              },
              "windowBackground": {
                "light": "#fff8f5",
                "dark": "#fff8f5"
              }
            },
            "timePicker": {
              "background": {
                "light": "#fff8f5",
                "dark": "#fff8f5"
              },
              "headerBackground": {
                "light": "#43654f",
                "dark": "#43654f"
              },
              "numbersBackgroundColor": {
                "light": "#f5ece7",
                "dark": "#f5ece7"
              },
              "numbersSelectorColor": {
                "light": "#43654f",
                "dark": "#43654f"
              },
              "numbersTextColor": {
                "light": "#1e1b18",
                "dark": "#1e1b18"
              },
              "numbersInnerTextColor": {
                "light": "#424843",
                "dark": "#424843"
              }
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#5B7E67"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
