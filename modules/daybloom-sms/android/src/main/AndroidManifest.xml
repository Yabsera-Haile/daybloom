<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Reading bank and mobile-money texts to add spending (BU-11). Texts stay on the phone. -->
  <uses-permission android:name="android.permission.READ_SMS" />
  <uses-permission android:name="android.permission.RECEIVE_SMS" />

  <application>
    <receiver
      android:name="expo.modules.daybloomsms.SmsReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
    <receiver android:name="expo.modules.daybloomsms.ReplyReceiver" android:exported="false" />
  </application>
</manifest>
